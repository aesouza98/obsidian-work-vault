filters:
  and:
    - categories.contains(link("Worklogs"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.date:
    displayName: Date
  note.org:
    displayName: Org
views:
  - type: table
    name: Logs
    order:
      - file.name
      - date
      - org
      - file.path
    sort:
      - property: date
        direction: DESC
      - property: created
        direction: DESC
    columnSize:
      file.name: 181
  - type: table
    name: Related
    filters:
      and:
        - file.hasLink(this)
    order:
      - file.name
      - date
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 225
