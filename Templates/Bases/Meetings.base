filters:
  and:
    - categories.contains(link("Meetings"))
    - '!file.name.contains("Template")'
properties:
  note.date:
    displayName: Date
  note.people:
    displayName: People
  note.type:
    displayName: Type
  file.name:
    displayName: Meeting
  note.org:
    displayName: Org
  note.loc:
    displayName: Location
  note.teams:
    displayName: Teams
views:
  - type: table
    name: Meetings
    order:
      - file.name
      - date
      - type
      - people
      - teams
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Person
    filters:
      and:
        - list(people).contains(this)
        - '!type.contains(link("Services"))'
    order:
      - file.name
      - date
      - type
      - people
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - date
      - people
      - org
      - loc
      - file.path
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 261
      note.date: 117
      note.people: 154
  - type: table
    name: Place
    filters:
      or:
        - list(loc).contains(this)
    order:
      - file.name
      - date
      - type
      - people
      - categories
    sort:
      - property: categories
        direction: ASC
      - property: date
        direction: DESC
  - type: table
    name: Topic
    filters:
      and:
        - list(topics).contains(this)
    order:
      - file.name
      - date
      - type
      - people
    sort:
      - property: date
        direction: ASC
  - type: table
    name: Org
    filters:
      or:
        - list(org).contains(this)
    order:
      - file.name
      - date
      - type
      - people
      - categories
    sort:
      - property: categories
        direction: ASC
      - property: date
        direction: DESC
  - type: table
    name: Team
    filters:
      and:
        - list(teams).contains(this)
        - '!type.contains(link("Services"))'
    order:
      - file.name
      - date
      - type
      - people
    sort:
      - property: date
        direction: DESC
