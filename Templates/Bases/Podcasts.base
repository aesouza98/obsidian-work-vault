filters:
  and:
    - note.categories.contains(link("Podcasts"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Podcast
  note.host:
    displayName: Host
views:
  - type: table
    name: Table
    order:
      - file.name
      - host
  - type: table
    name: Host
    filters:
      and:
        - list(host).contains(this)
    order:
      - file.name
      - host
