filters:
  and:
    - categories.contains(link("Documentations"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.topics:
    displayName: Topics
  note.last:
    displayName: Last
views:
  - type: table
    name: All
    order:
      - file.name
      - type
      - topics
      - last
    sort:
      - property: last
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - topics
      - last
    sort:
      - property: last
        direction: DESC
      - property: file.name
        direction: ASC
